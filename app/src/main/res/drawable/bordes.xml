<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- El fondo verde claro de la cápsula -->
    <solid android:color="#E8F5E9" />
    <!-- El borde verde oscuro de 2dp -->
    <stroke
        android:width="2dp"
        android:color="#2D6A4F" />
    <!-- El radio de las esquinas (ajustado a los 12dp de tus tarjetas) -->
    <corners android:radius="12dp" />
</shape>
