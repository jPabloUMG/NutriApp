<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="¿Cuál es tu objetivo?"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#212121" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="Selecciona el que mejor te describe"
            android:textSize="14sp"
            android:textColor="#757575" />

        <!-- Perder peso -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardPerder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">
                <TextView android:layout_width="40dp" android:layout_height="wrap_content"
                    android:text="🔥" android:textSize="24sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Perder peso" android:textSize="16sp"
                        android:textStyle="bold" android:textColor="#212121"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Reducir grasa corporal" android:textSize="13sp"
                        android:textColor="#757575"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Mantener peso -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardMantener"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">
                <TextView android:layout_width="40dp" android:layout_height="wrap_content"
                    android:text="⚖️" android:textSize="24sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Mantener peso" android:textSize="16sp"
                        android:textStyle="bold" android:textColor="#212121"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Conservar mi composición corporal" android:textSize="13sp"
                        android:textColor="#757575"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Ganar peso -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardGanar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">
                <TextView android:layout_width="40dp" android:layout_height="wrap_content"
                    android:text="📈" android:textSize="24sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Ganar peso" android:textSize="16sp"
                        android:textStyle="bold" android:textColor="#212121"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Aumentar masa corporal" android:textSize="13sp"
                        android:textColor="#757575"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Definición -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardDefinir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">
                <TextView android:layout_width="40dp" android:layout_height="wrap_content"
                    android:text="💪" android:textSize="24sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Definición" android:textSize="16sp"
                        android:textStyle="bold" android:textColor="#212121"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Marcar músculo, reducir grasa" android:textSize="13sp"
                        android:textColor="#757575"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Volumen -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardVolumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">
                <TextView android:layout_width="40dp" android:layout_height="wrap_content"
                    android:text="🏋️" android:textSize="24sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Volumen" android:textSize="16sp"
                        android:textStyle="bold" android:textColor="#212121"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Ganar músculo al máximo" android:textSize="13sp"
                        android:textColor="#757575"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Nivel de actividad -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nivel de actividad física"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_marginBottom="12dp" />

        <!-- Sedentario -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardSedentario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="14dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Sedentario" android:textSize="15sp"
                    android:textStyle="bold" android:textColor="#212121"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Poco o ningún ejercicio" android:textSize="12sp"
                    android:textColor="#9E9E9E"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Ligero -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardLigero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="14dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Ligero" android:textSize="15sp"
                    android:textStyle="bold" android:textColor="#212121"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Ejercicio 1-3 días/semana" android:textSize="12sp"
                    android:textColor="#9E9E9E"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Moderado -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardModerado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="14dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Moderado" android:textSize="15sp"
                    android:textStyle="bold" android:textColor="#212121"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Ejercicio 3-5 días/semana" android:textSize="12sp"
                    android:textColor="#9E9E9E"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Activo -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardActivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="14dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Activo" android:textSize="15sp"
                    android:textStyle="bold" android:textColor="#212121"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Ejercicio intenso 6-7 días/semana" android:textSize="12sp"
                    android:textColor="#9E9E9E"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Muy activo -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardMuyActivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="14dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Muy activo" android:textSize="15sp"
                    android:textStyle="bold" android:textColor="#212121"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Atleta / trabajo físico intenso" android:textSize="12sp"
                    android:textColor="#9E9E9E"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Error -->
        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text=""
            android:textColor="#F44336"
            android:textSize="13sp"
            android:paddingStart="4dp" />

        <!-- Botón continuar -->
        <Button
            android:id="@+id/btnContinuar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="32dp"
            android:backgroundTint="#4CAF50"
            android:text="Comenzar"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

    </LinearLayout>
</ScrollView>